{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-quanly-toolpage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/v1/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "key-quanly-toolpage",
    "database_id": "080338a8-ef3f-4464-b5b0-a8570469b85f",
    "migrations_dir": "migrations"
  }]
}
